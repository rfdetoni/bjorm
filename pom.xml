<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.github.rfdetoni.bjorm</groupId>
  <artifactId>bjorm-parent</artifactId>
  <version>0.3.6-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>BJORM Parent</name>
  <description>Bare Metal Java ORM — framework-agnostic JDBC mapping</description>
  <url>https://github.com/rfdetoni/bjorm</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>
  <scm>
    <connection>scm:git:https://github.com/rfdetoni/bjorm.git</connection>
    <developerConnection>scm:git:https://github.com/rfdetoni/bjorm.git</developerConnection>
    <url>https://github.com/rfdetoni/bjorm</url>
    <tag>HEAD</tag>
  </scm>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <modules>
    <module>bjorm-core</module>
    <module>bjorm-processor</module>
    <module>bjorm-examples</module>
    <module>bjorm-spring-boot</module>
    <module>bjorm-benchmarks</module>
  </modules>

  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/rfdetoni/bjorm</url>
    </repository>
    <snapshotRepository>
      <id>github</id>
      <name>GitHub Packages Snapshots</name>
      <url>https://maven.pkg.github.com/rfdetoni/bjorm</url>
    </snapshotRepository>
  </distributionManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.14.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>3.1.4</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>versions-maven-plugin</artifactId>
          <version>2.19.1</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
